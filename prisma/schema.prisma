// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  animeHistory  AnimeHistory[]
  mangaHistory  MangaHistory[]
  animeFavorites AnimeFavorite[]
  mangaFavorites MangaFavorite[]
  doramaFavorites DoramaFavorite[]
  supportTickets SupportTicket[]
  telegramUser  TelegramUser?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AnimeHistory {
  id              String   @id @default(cuid())
  userId          String?  // Optional for Google users
  aniLibertyId    String?  // Optional for AniLiberty-only users
  titleId         String
  episode         Int
  season          Int
  progressSeconds Int
  timestamp       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ensure either userId or aniLibertyId is present, but this is handled in logic.
  @@unique([userId, aniLibertyId, titleId, episode, season])
}

model MangaHistory {
  id           String   @id @default(cuid())
  userId       String?
  aniLibertyId String?
  mangaId      String
  chapter      String
  page         Int
  timestamp    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, aniLibertyId, mangaId, chapter])
}

model AnimeFavorite {
  id              String   @id @default(cuid())
  userId          String?
  aniLibertyId    String?
  titleId         String
  titleName       String
  imageSrc        String?
  timestamp       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, aniLibertyId, titleId])
}

model MangaFavorite {
  id              String   @id @default(cuid())
  userId          String?
  aniLibertyId    String?
  mangaId         String
  titleName       String
  imageSrc        String?
  timestamp       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, aniLibertyId, mangaId])
}

model DoramaFavorite {
  id              String   @id @default(cuid())
  userId          String?
  aniLibertyId    String?
  doramaId        String
  titleName       String
  imageSrc        String?
  timestamp       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, aniLibertyId, doramaId])
}

model OtpAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())
}

model SupportTicket {
  id                String         @id @default(cuid())
  userId            String
  message           String
  status            String         @default("OPEN") // OPEN, REPLIED, CLOSED
  telegramMessageId Int?
  createdAt         DateTime       @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies SupportReply[]
}

model SupportReply {
  id        String   @id @default(cuid())
  ticketId  String
  message   String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  key   String @id
  value String
}

model TelegramUser {
  id        BigInt   @id // Telegram user ID (BigInt because Telegram IDs can be huge)
  username  String?
  firstName String?
  lastName  String?
  userId    String?  @unique // Link to website User if linked later
  createdAt DateTime @default(now())

  user          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions TelegramSubscription[]
}

model TelegramSubscription {
  id             String       @id @default(cuid())
  telegramUserId BigInt
  type           String       // "anime", "dorama", "manga"
  releaseId      String       // ID or alias of the release
  titleName      String       // Stored title for quick display
  imageSrc       String?      // Stored image for quick display
  lastEpisode    Int          @default(0) // Added for Stage 2 push notifications
  createdAt      DateTime     @default(now())

  telegramUser TelegramUser @relation(fields: [telegramUserId], references: [id], onDelete: Cascade)

  @@unique([telegramUserId, type, releaseId])
}
