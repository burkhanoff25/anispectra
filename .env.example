# AniLiberty (аниме) — публичный API, ключ не требуется
NEXT_PUBLIC_ANILIBERTY_BASE=https://anilibria.top/api/v1

# Kodik (дорамы) — токен доступа к API
KODIK_API_TOKEN=your_token_here
NEXT_PUBLIC_KODIK_BASE=https://kodik-api.com

# MangaDex (манга) — публичный API, ключ не требуется
NEXT_PUBLIC_MANGADEX_BASE=https://api.mangadex.org
NEXT_PUBLIC_MANGADEX_UPLOADS=https://uploads.mangadex.org

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/anispectra

# Next Auth
NEXTAUTH_SECRET=your_secret_here
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TMDB (The Movie Database)
TMDB_READ_TOKEN=your_tmdb_read_token_here
TMDB_API_KEY=your_tmdb_api_key_here

# Disqus
NEXT_PUBLIC_DISQUS_SHORTNAME=anispectra-uz

# Cron
CRON_SECRET=
