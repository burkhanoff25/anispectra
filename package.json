{
  "name": "anispectra",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "prisma generate && prisma db push --accept-data-loss && next build",
    "start": "NODE_ENV=production node server.js",
    "start:userbot": "ts-node --project tsconfig.ts-node.json src/scripts/telegram-userbot.ts",
    "start:bot": "ts-node --project tsconfig.ts-node.json src/scripts/telegram-bot-polling.ts",
    "sync:history": "ts-node --project tsconfig.ts-node.json src/scripts/fetch-last-videos.ts",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@libsql/client": "^0.17.4",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-neon": "^7.9.0",
    "@prisma/client": "^7.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-sqlite3": "^12.11.1",
    "grammy": "^1.46.0",
    "hls.js": "1.5.13",
    "input": "^1.0.1",
    "lucide-react": "^1.25.0",
    "next": "^14.2.23",
    "next-auth": "^4.24.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-player": "^3.4.0",
    "resend": "^6.18.0",
    "server-only": "0.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "telegram": "^2.26.22",
    "ts-node": "^10.9.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "autoprefixer": "10.4.19",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "8.4.39",
    "prisma": "^7.8.0",
    "tailwindcss": "3.4.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
